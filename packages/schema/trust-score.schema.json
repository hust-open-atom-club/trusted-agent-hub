{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusted-agent-hub.dev/schemas/trust-score.schema.json",
  "title": "Trust Score",
  "description": "信任评分结果 Schema，由评分模型生成，供 Web 详情页和 CLI 安装前展示",
  "type": "object",
  "required": [
    "score",
    "package_name",
    "version",
    "calculated_at",
    "model_fingerprint",
    "model_version",
    "security_assessment",
    "evidence_assessment",
    "dimensions",
    "explanations"
  ],
  "properties": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "安全风险评分（0-100）；证据完整度与作者信誉见 evidence_assessment"
    },
    "score_breakdown": {
      "type": "object",
      "required": [
        "base_score",
        "advisory_deduction",
        "final_score",
        "grade_is_security_policy",
        "evidence_score",
        "evidence_coverage",
        "unapplied_advisory_points"
      ],
      "properties": {
        "base_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "advisory_deduction": { "type": "integer", "minimum": 0, "maximum": 100 },
        "final_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "grade_is_security_policy": { "type": "boolean" },
        "evidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "evidence_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "unapplied_advisory_points": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false,
      "description": "安全评分与独立证据指标；advisory 点数仅审计展示，不从安全分扣除"
    },
    "security_assessment": {
      "type": "object",
      "required": ["score", "level", "grade", "status", "input_dimensions", "unresolved_findings"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "level": { "enum": ["trusted", "low_risk", "medium_risk", "high_risk", "untrusted"] },
        "grade": { "enum": ["A", "B", "C", "D", "E"] },
        "status": { "enum": ["conclusive", "review_required", "inconclusive"] },
        "input_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["permission_minimization", "scan_results"] }
        },
        "unresolved_findings": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false,
      "description": "仅由权限、扫描结果及安全复核状态驱动的安全结论"
    },
    "evidence_assessment": {
      "type": "object",
      "required": [
        "score",
        "coverage",
        "level",
        "assessed_dimensions",
        "unavailable_dimensions",
        "verification_statuses",
        "author_reputation"
      ],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "level": { "enum": ["strong", "moderate", "limited", "unavailable"] },
        "assessed_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "unavailable_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "verification_statuses": {
          "type": "object",
          "additionalProperties": { "enum": ["verified", "not_verified", "not_available"] }
        },
        "author_reputation": {
          "type": "object",
          "required": ["status", "level", "score"],
          "properties": {
            "status": { "enum": ["assessed", "unavailable"] },
            "level": { "enum": ["consistent_good", "newcomer", "inconsistent", "tainted", "unavailable"] },
            "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "来源、供应链证明、元数据、作者信誉和社区信号的独立证据指标"
    },
    "package_name": {
      "type": "string",
      "description": "能力包名称"
    },
    "version": {
      "type": "string",
      "description": "版本号"
    },
    "calculated_at": {
      "type": "string",
      "format": "date-time",
      "description": "评分计算时间"
    },
    "model_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "评分源码和相关配置的确定性 SHA-256 指纹"
    },
    "model_version": {
      "type": "string",
      "description": "由 model_fingerprint 派生的兼容展示标识，不用于模型变更判断"
    },
    "dimensions": {
      "type": "object",
      "required": [
        "source_trust",
        "author_reputation",
        "metadata_completeness",
        "permission_minimization",
        "scan_results",
        "manual_review",
        "version_stability",
        "user_feedback",
        "signature_verifiability"
      ],
      "properties": {
        "source_trust": {
          "type": "object",
          "required": ["score", "weight", "details"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "details": {
              "type": "object",
              "properties": {
                "is_verified_owner": { "type": "boolean" },
                "available": { "type": "boolean" },
                "source_type": { "type": "string" },
                "repo_age_days": { "type": "integer", "minimum": 0 },
                "has_commit_hash": { "type": "boolean" },
                "has_integrity_hash": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "description": "来源可信度维度"
        },
        "author_reputation": {
          "type": "object",
          "required": ["score", "weight"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "details": {
              "type": "object",
              "properties": {
                "packages_published": { "type": "integer", "minimum": 0 },
                "avg_historical_score": { "type": "integer", "minimum": 0, "maximum": 100 },
                "violations_count": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "description": "作者信誉维度"
        },
        "metadata_completeness": {
          "type": "object",
          "required": ["score", "weight"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "details": {
              "type": "object",
              "properties": {
                "missing_required_fields": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "has_description": { "type": "boolean" },
                "has_license": { "type": "boolean" },
                "has_keywords": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "description": "元数据完整度维度"
        },
        "permission_minimization": {
          "type": "object",
          "required": ["score", "weight"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "details": {
              "type": "object",
              "properties": {
                "total_permissions": { "type": "integer", "minimum": 0 },
                "high_risk_permissions": { "type": "integer", "minimum": 0 },
                "unnecessary_permissions": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "permission_evidence_count": { "type": "integer", "minimum": 0 },
                "ignored_low_confidence_count": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "description": "权限最小化维度"
        },
        "scan_results": {
          "type": "object",
          "required": ["score", "weight"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "details": {
              "type": "object",
              "properties": {
                "critical_findings": { "type": "integer", "minimum": 0 },
                "high_findings": { "type": "integer", "minimum": 0 },
                "medium_findings": { "type": "integer", "minimum": 0 },
                "low_findings": { "type": "integer", "minimum": 0 },
                "scan_pass_rate": { "type": "number", "minimum": 0, "maximum": 100 },
                "scan_state": { "type": "string" },
                "scan_conclusion": { "type": "string" },
                "scan_complete": { "type": "boolean" },
                "failed_rules": {
                  "type": "array",
                  "items": { "type": ["string", "null"] }
                },
                "skipped_files": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "description": "扫描结果维度"
        },
        "manual_review": {
          "type": "object",
          "required": ["score", "weight"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "details": {
              "type": "object",
              "properties": {
                "review_status": {
                  "type": "string",
                  "enum": ["unreviewed", "approved", "rejected", "changes_requested"]
                },
                "reviewer_count": { "type": "integer", "minimum": 0 },
                "last_reviewed_at": { "type": "string", "format": "date-time" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "description": "人工审核维度"
        },
        "version_stability": {
          "type": "object",
          "required": ["score", "weight"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "details": {
              "type": "object",
              "properties": {
                "total_versions": { "type": "integer", "minimum": 0 },
                "is_stable": { "type": "boolean" },
                "days_since_last_update": { "type": "integer", "minimum": 0 },
                "breaking_changes_count": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "description": "版本稳定性维度"
        },
        "user_feedback": {
          "type": "object",
          "required": ["score", "weight"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "details": {
              "type": "object",
              "properties": {
                "avg_rating": { "type": "number", "minimum": 0, "maximum": 5 },
                "total_ratings": { "type": "integer", "minimum": 0 },
                "total_installs": { "type": "integer", "minimum": 0 },
                "reports_count": { "type": "integer", "minimum": 0 },
                "level_counts": {
                  "type": "object",
                  "required": ["positive", "neutral", "negative"],
                  "properties": {
                    "positive": { "type": "integer", "minimum": 0 },
                    "neutral": { "type": "integer", "minimum": 0 },
                    "negative": { "type": "integer", "minimum": 0 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "description": "用户反馈维度"
        },
        "signature_verifiability": {
          "type": "object",
          "required": ["score", "weight"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "details": {
              "type": "object",
              "properties": {
                "has_signature": { "type": "boolean" },
                "has_attestation": { "type": "boolean" },
                "has_sbom": { "type": "boolean" },
                "available": { "type": "boolean" },
                "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
                "verification_statuses": {
                  "type": "object",
                  "additionalProperties": { "enum": ["verified", "not_verified", "not_available"] }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "description": "签名可追溯维度"
        }
      },
      "additionalProperties": false
    },
    "explanations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dimension", "message", "deduction"],
        "properties": {
          "dimension": {
            "type": "string",
            "description": "关联的评分维度"
          },
          "message": {
            "type": "string",
            "description": "扣分/加分说明"
          },
          "deduction": {
            "type": "integer",
            "description": "扣分分值（负数）或加分分值（正数）"
          },
          "evidence": {
            "type": "string",
            "description": "支撑证据引用（如扫描 finding ID）"
          }
        },
        "additionalProperties": false
      },
      "description": "评分解释列表"
    },
    "risk_summary": {
      "type": "object",
      "required": ["level", "grade"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["trusted", "low_risk", "medium_risk", "high_risk", "untrusted"],
          "description": "风险等级"
        },
        "grade": {
          "type": "string",
          "enum": ["A", "B", "C", "D", "E"],
          "description": "A-E 综合安全等级"
        },
        "top_risks": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string" },
          "description": "Top N 主要风险点"
        },
        "install_recommendation": {
          "type": "string",
          "enum": ["safe", "review_recommended", "caution", "not_recommended", "blocked"],
          "description": "安装建议"
        },
        "requires_confirmation": {
          "type": "boolean",
          "default": false,
          "description": "安装前是否必须显式确认"
        },
        "manual_security_review_required": {
          "type": "boolean",
          "default": false
        },
        "review_priority": {
          "type": "string",
          "enum": ["normal", "manual", "high"]
        },
        "advisory_grade_downgrade_applied": {
          "type": "boolean",
          "default": false
        },
        "advisory_grade_downgrade_reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
