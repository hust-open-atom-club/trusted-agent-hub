{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusted-agent-hub.dev/schemas/scan-report.schema.json",
  "title": "Risk Scan Report",
  "description": "自动风险扫描报告 Schema，由扫描器生成，供审核员和评分模型使用",
  "type": "object",
  "required": [
    "scan_id",
    "package_name",
    "version",
    "scanned_at",
    "scanner_version",
    "findings",
    "summary"
  ],
  "properties": {
    "review_advisories": {
      "type": "array",
      "description": "Reviewer-facing quality/provenance/consistency warnings that are not security findings.",
      "items": {
        "type": "object",
        "required": [
          "id", "code", "category", "level", "title", "description",
          "deduction", "affects_grade", "grade_downgrade_steps",
          "requires_manual_review"
        ],
        "properties": {
          "id": { "type": "string" },
          "code": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["metadata_quality", "provenance", "permission_consistency"]
          },
          "level": { "type": "string", "enum": ["high", "warning", "info"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "deduction": { "type": "integer", "minimum": 0, "maximum": 100 },
          "affects_grade": { "type": "boolean" },
          "grade_downgrade_steps": { "type": "integer", "minimum": 0, "maximum": 1 },
          "requires_manual_review": { "type": "boolean" },
          "evidence": { "type": "string" },
          "location": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "advisory_summary": {
      "type": "object",
      "required": [
        "total", "high", "warning", "info", "deduction_total",
        "grade_downgrade_steps", "manual_review_required"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "deduction_total": { "type": "integer", "minimum": 0, "maximum": 100 },
        "grade_downgrade_steps": { "type": "integer", "minimum": 0, "maximum": 1 },
        "manual_review_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "permission_evidence": {
      "type": "array",
      "description": "Capability provenance used to distinguish executable behavior from documentation-only mentions.",
      "items": {
        "type": "object",
        "required": ["capability", "status", "confidence", "source", "evidence"],
        "properties": {
          "capability": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["observed", "declared", "conditional", "mentioned", "inferred"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": {
            "type": "string",
            "enum": ["code", "manifest", "frontmatter", "docs"]
          },
          "file": { "type": "string" },
          "evidence": { "type": "string", "maxLength": 240 }
        },
        "additionalProperties": false
      }
    },
    "scan_id": {
      "type": "string",
      "description": "扫描任务唯一标识"
    },
    "package_name": {
      "type": "string",
      "description": "被扫描的能力包名称"
    },
    "version": {
      "type": "string",
      "description": "被扫描的版本号"
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time",
      "description": "扫描时间（ISO 8601）"
    },
    "scanner_version": {
      "type": "string",
      "description": "扫描器版本"
    },
    "source_snapshot_id": {
      "type": "string",
      "description": "独立源码快照标识，不包含源码内容"
    },
    "source_snapshot_sha256": {
      "type": "string",
      "description": "源码快照摘要"
    },
    "source_snapshot_created_at": {
      "type": "integer",
      "minimum": 0
    },
    "source_snapshot_expires_at": {
      "type": "integer",
      "minimum": 0
    },
    "provenance": {
      "type": "object",
      "description": "源码声明与采集层事实的隔离审计记录",
      "required": ["acquisition_facts", "package_claims"],
      "properties": {
        "acquisition_facts": {
          "type": "object",
          "required": ["source", "integrity", "verification", "acquisition_method"],
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "repository_url": { "type": "string" },
                "owner": { "type": "string" },
                "repo": { "type": "string" },
                "ref_type": { "type": "string" },
                "ref": { "type": "string" },
                "commit_hash": { "type": "string", "pattern": "^(?:[a-f0-9]{40})?$" },
                "verified_owner": { "type": "boolean" },
                "subdirectory": { "type": "string" }
              },
              "additionalProperties": false
            },
            "integrity": {
              "type": "object",
              "properties": {
                "sha256": { "type": "string", "pattern": "^(?:[a-f0-9]{64})?$" },
                "hash_scope": { "type": "string", "enum": ["scanned_source"] },
                "is_complete": { "type": "boolean" }
              },
              "additionalProperties": false
            },
            "verification": {
              "type": "object",
              "required": ["owner", "signature", "attestation", "sbom"],
              "properties": {
                "repository": { "type": "boolean", "default": false },
                "owner": { "type": "boolean" },
                "signature": { "type": "boolean" },
                "attestation": { "type": "boolean" },
                "sbom": { "type": "boolean" }
              },
              "additionalProperties": false
            },
            "acquisition_method": { "type": "string" }
          },
          "additionalProperties": false
        },
        "package_claims": {
          "type": "object",
          "properties": {
            "source": { "type": "object", "additionalProperties": true },
            "integrity": { "type": "object", "additionalProperties": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "扫描耗时（毫秒）"
    },
    "scan_status": {
      "type": "object",
      "required": ["state", "conclusion", "complete", "reasons"],
      "properties": {
        "state": { "type": "string", "enum": ["complete", "partial", "failed"] },
        "conclusion": { "type": "string", "enum": ["risks_found", "no_risks_found", "inconclusive"] },
        "complete": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "scan_limits": {
      "type": "object",
      "required": ["configured", "observed", "exceeded", "skipped"],
      "properties": {
        "configured": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "observed": {
          "type": "object",
          "properties": {
            "discovered_files": { "type": "integer", "minimum": 0 },
            "discovered_count": { "type": "integer", "minimum": 0 },
            "discovered_at_least": { "type": "boolean" },
            "analyzed_files": { "type": "integer", "minimum": 0 },
            "discovered_bytes": { "type": "integer", "minimum": 0 },
            "analyzed_bytes": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "exceeded": { "type": "array", "items": { "type": "string" } },
        "skipped": {
          "type": "object",
          "required": ["count", "by_reason", "samples"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "by_reason": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
            "samples": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "rule_execution": {
      "type": "object",
      "required": ["total", "succeeded", "failed", "skipped", "results"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "succeeded": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "results": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": false
    },
    "scanner_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "error_type", "message", "recoverable"],
        "properties": {
          "phase": { "type": "string" }, "rule_id": { "type": "string" },
          "error_type": { "type": "string" }, "message": { "type": "string" },
          "recoverable": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule_id", "severity", "category", "title", "location"],
        "properties": {
          "id": {
            "type": "string",
            "description": "发现项唯一 ID"
          },
          "rule_id": {
            "type": "string",
            "description": "触发的规则 ID",
            "examples": ["SR-001", "SR-002"]
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"],
            "description": "兼容字段；Scanner v2 中镜像 effective_severity"
          },
          "static_severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"],
            "description": "不可变的原始检测器严重程度"
          },
          "effective_severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"],
            "description": "根因聚合和语义裁决后用于评分的严重程度"
          },
          "root_cause_id": {
            "type": "string",
            "pattern": "^root-[a-f0-9]{20}$",
            "description": "由位置、sink 和 source 语义生成的稳定根因 ID"
          },
          "detector_ids": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true,
            "description": "合并到此根因的原始规则 ID"
          },
          "detector_hits": {
            "type": "array",
            "description": "不可变的原始规则命中审计记录",
            "items": {
              "type": "object",
              "required": [
                "id", "rule_id", "static_severity", "effective_severity",
                "category", "sink_kind", "source_kind", "location"
              ],
              "properties": {
                "id": { "type": "string" },
                "rule_id": { "type": "string" },
                "static_severity": {
                  "type": "string",
                  "enum": ["critical", "high", "medium", "low", "info"]
                },
                "effective_severity": {
                  "type": "string",
                  "enum": ["critical", "high", "medium", "low", "info"]
                },
                "category": { "type": "string" },
                "sink_kind": { "type": "string" },
                "source_kind": { "type": "string" },
                "location": { "type": "object" },
                "evidence": { "type": "string" },
                "remediation": { "type": "string" },
                "cwe_id": { "type": "string" },
                "requires_confirmation": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "sink_kind": { "type": "string" },
          "sink_symbol": { "type": "string" },
          "source_kind": { "type": "string" },
          "source_symbol": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "unclassified", "vulnerability", "capability", "context_dependent",
              "policy", "informational"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "pending", "confirmed", "confirmed_vulnerability",
              "intentional_capability", "false_positive", "needs_context"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "prompt_injection",
              "dangerous_shell",
              "credential_access",
              "hardcoded_secret",
              "remote_code_execution",
              "excessive_permission",
              "network_access",
              "dependency_risk",
              "source_integrity",
              "metadata_quality",
              "supply_chain",
              "installation_security",
              "output_handling",
              "system_prompt_leakage",
              "memory_poisoning",
              "ssrf",
              "agent_snooping",
              "tool_misuse",
              "mcp_security",
              "plugin_security",
              "subagent_security"
            ],
            "description": "风险分类"
          },
          "title": {
            "type": "string",
            "description": "发现项简述"
          },
          "description": {
            "type": "string",
            "description": "详细描述"
          },
          "location": {
            "type": "object",
            "required": ["file"],
            "properties": {
              "file": { "type": "string", "description": "文件路径" },
              "line": { "type": "integer", "minimum": 1, "description": "起始行号" },
              "column": { "type": "integer", "minimum": 1, "description": "起始列号" },
              "end_line": { "type": "integer", "minimum": 1 },
              "end_column": { "type": "integer", "minimum": 1 },
              "snippet": { "type": "string", "description": "匹配到的代码片段（已脱敏）" }
            },
            "additionalProperties": false
          },
          "llm_label": {
            "type": "string",
            "enum": [
              "llm:suspected-malicious",
              "llm:suspected-negligent",
              "llm:likely-benign",
              "llm:uncertain",
              "llm:unavailable"
            ],
            "description": "LLM 审查标签"
          },
          "candidate_severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"],
            "description": "需要语义复核时保留的静态候选严重度"
          },
          "requires_llm_validation": {
            "type": "boolean",
            "description": "该静态文本命中必须通过上下文语义复核后才能参与安全评分"
          },
          "llm_review_state": {
            "type": "string",
            "enum": [
              "pending", "confirmed_harmful", "confirmed_risky",
              "likely_benign", "uncertain", "unavailable"
            ]
          },
          "llm_impact": {
            "type": "string",
            "enum": ["none", "low", "medium", "high", "critical", "unknown"]
          },
          "llm_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "llm_explanation": { "type": "string" },
          "llm_review_rounds": { "type": "integer", "minimum": 0, "maximum": 3 },
          "requires_manual_review": {
            "type": "boolean",
            "description": "自动语义判定未能给出可靠结论，需要人工安全审核"
          },
          "downgraded": {
            "type": "string",
            "description": "严重度降级原因标记（如 documentation=说明性文档降级）"
          },
          "evidence": {
            "type": "string",
            "description": "证据说明"
          },
          "remediation": {
            "type": "string",
            "description": "修复建议"
          },
          "requires_confirmation": {
            "type": "boolean",
            "description": "执行前必须展示风险并取得用户确认"
          },
          "cwe_id": {
            "type": "string",
            "description": "关联的 CWE 编号"
          },
          "occurrences": {
            "type": "object",
            "description": "同一规则和匹配内容在多个位置出现时的报告层聚合",
            "required": ["count", "items", "truncated"],
            "properties": {
              "count": { "type": "integer", "minimum": 1 },
              "items": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "required": ["file"],
                  "properties": {
                    "file": { "type": "string" },
                    "line": { "type": "integer", "minimum": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "truncated": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "critical", "high", "medium", "low", "info"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "root_cause_total": {
          "type": "integer",
          "minimum": 0,
          "description": "用于评分的独立根因数量"
        },
        "detector_hit_total": {
          "type": "integer",
          "minimum": 0,
          "description": "聚合前的原始规则命中数量"
        },
        "effective_total": {
          "type": "integer",
          "minimum": 0,
          "description": "报告层聚合后的 finding 数（critical+high+medium+low，不含 info）"
        },
        "occurrences_total": {
          "type": "integer",
          "minimum": 0,
          "description": "聚合前原始 finding occurrence 总数"
        },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "扫描通过率（百分比，0-100）"
        }
      },
      "additionalProperties": false
    },
    "metadata_validation": {
      "type": "object",
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "parse_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "message"],
            "properties": {
              "file": { "type": "string" },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "元数据校验结果"
    },
    "structure_check": {
      "type": "object",
      "properties": {
        "valid": { "type": "boolean" },
        "missing_files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "缺失的必要文件"
        },
        "extra_files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "可疑的额外文件"
        }
      },
      "additionalProperties": false,
      "description": "目录结构校验结果"
    },
    "dependency_check": {
      "type": "object",
      "properties": {
        "total_dependencies": { "type": "integer", "minimum": 0 },
        "known_vulnerabilities": { "type": "integer", "minimum": 0 },
        "unlocked_versions": { "type": "integer", "minimum": 0 },
        "suspicious_packages": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false,
      "description": "依赖检查结果"
    },
    "dependency_scan": {
      "type": "object",
      "required": ["status", "dependencies_found", "dependencies_queried", "query_failures"],
      "properties": {
        "status": { "type": "string", "enum": ["complete", "partial"] },
        "dependencies_found": { "type": "integer", "minimum": 0 },
        "dependencies_queried": { "type": "integer", "minimum": 0 },
        "query_failures": { "type": "integer", "minimum": 0 },
        "query_limit": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false,
      "description": "依赖解析和 OSV 查询覆盖率"
    },
    "structural_analysis": {
      "type": "object",
      "required": [
        "python_files",
        "javascript_files",
        "shell_files",
        "structured_documents",
        "parse_errors",
        "capability_graph"
      ],
      "properties": {
        "python_files": { "type": "integer", "minimum": 0 },
        "javascript_files": { "type": "integer", "minimum": 0 },
        "shell_files": { "type": "integer", "minimum": 0 },
        "structured_documents": { "type": "integer", "minimum": 0 },
        "parse_errors": { "type": "integer", "minimum": 0 },
        "capability_graph": {
          "type": "object",
          "required": ["declared", "observed", "undeclared_observed", "edge_count"],
          "properties": {
            "declared": { "type": "array", "items": { "type": "string" } },
            "observed": { "type": "array", "items": { "type": "string" } },
            "undeclared_observed": { "type": "array", "items": { "type": "string" } },
            "edge_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "结构化解析与能力图摘要，不包含源码内容"
    },
    "llm_review": {
      "type": "object",
      "properties": {
        "triggered": { "type": "boolean", "description": "是否触发了 LLM 审查" },
        "findings_reviewed": { "type": "integer", "description": "LLM 审查的 finding 数量" },
        "findings_skipped": { "type": "integer", "minimum": 0 },
        "findings_pending": { "type": "integer", "minimum": 0 },
        "status": {
          "type": "string",
          "enum": ["not_triggered", "not_required", "not_configured", "completed", "call_failed"]
        },
        "attempts": { "type": "integer", "minimum": 0 },
        "labels_summary": {
          "type": "object",
          "properties": {
            "suspected_malicious": { "type": "integer" },
            "suspected_negligent": { "type": "integer" },
            "likely_benign": { "type": "integer" },
            "uncertain": { "type": "integer" },
            "unavailable": { "type": "integer" }
          }
        },
        "error": { "type": "string", "description": "LLM 审查错误信息" },
        "fallback": { "type": "string", "description": "LLM 审查降级说明" }
      },
      "additionalProperties": true,
      "description": "LLM 深度审查结果"
    }
  },
  "additionalProperties": false
}
