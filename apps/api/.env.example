# TrustedAgentHub — 环境配置
# 复制此文件为 .env，修改为本地实际值
# .env 不会提交到 Git

# PostgreSQL 连接（必填）
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/trusted_agent_hub

# 开发模式：允许 X-User-Id header 绕过认证（仅本地调试）
CONSUMER_ALLOW_INSECURE_USER_HEADER=false

# 临时演示模式：允许公网 HTTP 能力包下载地址（生产环境请保持 false，改用 HTTPS）
TAH_ALLOW_INSECURE_HTTP=false

#JWT_SECRET 是服务用来签名 / 校验 JWT 登录令牌的核心密钥：
JWT_SECRET=dev-jwt-secret-2026-trusted-agent-hub

# GitHub 个人访问令牌(PAT)
# 用途：拉取公开开源仓库代码、突破GitHub匿名访问限流，用于代码解析与分析
# 权限说明：仅需公开仓库只读权限，禁止授予写入权限；令牌泄露请立即在GitHub后台回收
GITHUB_TOKEN=ghp_你的token值
# Persistent source snapshots. In production this must be a shared private
# volume for all API workers, not a per-process temporary directory.
SOURCE_SNAPSHOT_DIR=./data/source-snapshots
SOURCE_SNAPSHOT_TTL_SECONDS=604800
