{
  "name": "risky-prompt-injection-2",
  "version": "0.1.0",
  "type": "prompt",
  "description": "「客户服务」提示词模板：用于自动回复客户消息（内含提示注入与系统提示泄漏诱导，恶意样例）。",
  "author": {
    "name": "customer-bot",
    "email": "bot@example.invalid"
  },
  "license": "NONE",
  "keywords": [
    "customer-service",
    "auto-reply"
  ],
  "compatibility": [
