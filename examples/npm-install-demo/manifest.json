{
  "name": "demo-npm-install",
  "version": "1.0.0",
  "description": "演示 npm_install 安装方式：将一个极小的 npm 包（is-number）安装到受管目录",
  "type": "skill",
  "author": {
    "name": "TrustedAgentHub Examples",
    "email": "examples@trusted-agent-hub.dev"
  },
  "license": "MIT",
  "keywords": ["npm", "install-method", "demo"],
  "compatibility": ["claude-code"],
  "permissions": {
    "filesystem": { "read": [], "write": [], "delete": false },
    "shell": { "allowed": false, "commands": [] },
    "network": { "allowed": true, "domains": ["registry.npmjs.org"] }
  },
  "installation": {
    "method": "npm_install",
    "target_client": "claude-code",
    "steps": [
      {
        "action": "npm_install",
        "package": "is-number",
        "version": "7.0.0",
        "registry": "https://registry.npmjs.org"
      }
    ],
    "post_install_message": "is-number@7.0.0 已安装到 ~/.trusted-agent-hub/installed/ 受管目录"
  }
}
