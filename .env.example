# TrustedAgentHub unified environment configuration
# Copy this file to .env in the repository root. Never commit .env.

# Docker Compose and service ports (not secret)
COMPOSE_PROJECT_NAME=trusted-agent-hub
POSTGRES_PORT=5432
# Leave API_HOST blank: local API defaults to 127.0.0.1, while Docker Compose
# defaults to 0.0.0.0. API_RELOAD is only read by `apps/api/run.py`; the API
# image always starts without reload.
API_HOST=
API_PORT=8000
API_RELOAD=
WEB_PORT=3000
PUBLIC_API_BASE_URL=http://localhost:8000

# PostgreSQL connection -- choose one mode:
# 1. Local + Docker Compose (recommended): fill the three POSTGRES_* values and
#    leave DATABASE_HOST and DATABASE_URL blank. Local runs use 127.0.0.1;
#    Compose uses its `db` service. POSTGRES_PASSWORD is required by Compose.
# 2. Local API only: set DATABASE_URL to a localhost URL. Before running Compose,
#    clear it and configure mode 1; localhost inside the API container is not
#    the Compose database. A non-empty DATABASE_URL overrides all values below.
POSTGRES_USER=trusted_agent_hub
POSTGRES_PASSWORD=
POSTGRES_DB=trusted_agent_hub
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_DRIVER=postgresql
DATABASE_URL=
# Local-only example (replace the password, then remove the leading "# "):
# DATABASE_URL=postgresql://trusted_agent_hub:your_password@localhost:5432/trusted_agent_hub

# Optional PostgreSQL integration-test database. Pytest reads only this key
# from the root .env and never reuses DATABASE_URL for integration tests.
TEST_DATABASE_URL=

# Authentication and browser security
# Remove INITIAL_ADMIN_PASSWORD after the first administrator exists.
JWT_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_DISPLAY_NAME=Administrator
CORS_ALLOWED_ORIGINS=http://localhost:3000
CONSUMER_ALLOW_INSECURE_USER_HEADER=false
TAH_ALLOW_INSECURE_HTTP=false

# GitHub source acquisition (optional; public-repository read access only)
GITHUB_TOKEN=

# Optional LLM review provider. Configure OpenAI or Anthropic, not both.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional shared override. Leave blank for the provider-specific default model.
SKILLSPECTOR_MODEL=

# Public web configuration (never put secrets in NEXT_PUBLIC_* variables)
# These values are embedded into the browser bundle during docker build.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Optional disposable demo credentials; these are public in browser code.
NEXT_PUBLIC_DEMO_ACCOUNT_EMAIL=
NEXT_PUBLIC_DEMO_ACCOUNT_PASSWORD=

# Persistent data and optional semantic model. Leave container paths blank:
# local development uses app-local defaults and Compose supplies container paths.
ARTIFACTS_ROOT=
SOURCE_SNAPSHOT_DIR=
SOURCE_SNAPSHOT_TTL_SECONDS=604800
FASTEMBED_CACHE_PATH=
ENABLE_SEMANTIC_MODEL=false

# Optional CLI configuration for commands run from this checkout
TRUSTED_AGENT_HUB_API_URL=http://localhost:8000
TRUSTED_AGENT_HUB_TOKEN=

# Optional development seed accounts. The seed command skips blank pairs.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_REVIEWER_EMAIL=
SEED_REVIEWER_PASSWORD=
SEED_SUBMITTER_EMAIL=
SEED_SUBMITTER_PASSWORD=
