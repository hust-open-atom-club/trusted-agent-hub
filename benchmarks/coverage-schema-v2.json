{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusted-agent-hub.dev/schemas/benchmark-coverage-v2.schema.json",
  "title": "TrustedAgentHub scanner benchmark detector coverage v2",
  "type": "object",
  "required": ["$schema", "schema_version", "registry_source", "rules"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "2.0" },
    "registry_source": { "const": "scanners.risk_scanner.rule_runner.RULE_SPECS" },
    "rules": {
      "type": "object",
      "patternProperties": {
        "^SR-[0-9]{3}b?$": { "$ref": "#/$defs/ruleCoverage" }
      },
      "additionalProperties": false
    },
    "independent_variants": {
      "type": "array",
      "items": { "$ref": "#/$defs/independentVariant" }
    }
  },
  "$defs": {
    "caseIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "nonEmptyCaseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "ruleCoverage": {
      "type": "object",
      "required": ["positive_cases", "negative_cases", "context_cases"],
      "properties": {
        "positive_cases": { "$ref": "#/$defs/nonEmptyCaseIds" },
        "negative_cases": { "$ref": "#/$defs/caseIds" },
        "context_cases": { "$ref": "#/$defs/caseIds" }
      },
      "additionalProperties": false
    },
    "independentVariant": {
      "type": "object",
      "required": ["rule_id", "positive_cases", "forbidden_rules"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^SR-[0-9]{3}b?$" },
        "positive_cases": { "$ref": "#/$defs/nonEmptyCaseIds" },
        "forbidden_rules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SR-[0-9]{3}b?$" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
